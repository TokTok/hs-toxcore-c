load("@rules_haskell//haskell:defs.bzl", "haskell_library")
load("//third_party/haskell/c2hs:build_defs.bzl", "c2hs_library")
load("//third_party/haskell/hspec-discover:build_defs.bzl", "hspec_test")
load("//tools/project:build_defs.bzl", "project")

project(license = "gpl3-https")

c2hs_library(
    name = "tox_raw",
    src = "src/FFI/Tox/Raw.chs",
    tags = ["no-cross"],
    deps = [
        "//c-toxcore",
    ],
)

haskell_library(
    name = "hs-toxcore-c",
    srcs = glob(
        ["src/**/*.*hs"],
        exclude = ["src/**/*.chs"],
    ) + [":tox_raw"],
    linkstatic = True,
    src_strip_prefix = "src",
    tags = [
        "haskell",
        "no-cross",
    ],
    version = "0.2.20",
    visibility = ["//visibility:public"],
    deps = [
        ":tox_raw",
        "//c-toxcore",
        "//hs-msgpack-binary",
        "//third_party/haskell:QuickCheck",
        "//third_party/haskell:base",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:generic-arbitrary",
        "//third_party/haskell:quickcheck-instances",
    ],
)

hspec_test(
    name = "testsuite",
    timeout = "moderate",
    ghcopts = ["-Wno-missed-extra-shared-lib"],
    linkstatic = True,
    deps = [
        ":hs-toxcore-c",
        "//hs-msgpack-binary",
        "//third_party/haskell:QuickCheck",
        "//third_party/haskell:base",
        "//third_party/haskell:base16-bytestring",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:cryptohash",
        "//third_party/haskell:hspec",
        "//third_party/haskell:saltine",
        "//third_party/haskell:vector",
    ],
)
